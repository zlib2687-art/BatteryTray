<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BatteryTray</AssemblyName>
    <Version>1.0.0</Version>
    <Product>BatteryTray</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Confidentialité : les chemins de ton PC (ex. « D:\...\obj\Release\... ») ne sont pas écrits dans les fichiers compilés -->
    <PathMap>$(MSBuildProjectDirectory)=/src/BatteryTray</PathMap>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RootNamespace>BatteryTray</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Réglages d'empreinte mémoire : pas d'ICU (gros), pas de GC en arrière-plan, JIT léger -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Emplacement stable de l'exécutable : Windows retient l'épinglage et le démarrage auto par chemin -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BatteryTray.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- le GC restitue la mémoire plus agressivement -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

</Project>
